# Сборка и кэши
apps/replay-parser/build/
**/__pycache__/
*.pyc
# Локальные артефакты моделей (реестр — в S3)
*.pkl
# Секреты окружения (токены ботов, ключи доступа) — только локально
.env
*.env
deployments/.env

# Артефакты моделей и отчёты обучения: бинарные, воспроизводимые
# обучением, место им в реестре (MinIO/MLflow), а не в git.
apps/*/models/

# Зависимости утилиты проверки входа в Steam (make gc-node).
# Ставятся локально, в git им делать нечего.
scripts/gc-node/node_modules/
